<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AiCodingHub.App.Converters"
                    xmlns:w="clr-namespace:AiCodingHub.App.Widgets"
                    xmlns:b="clr-namespace:AiCodingHub.App.Behaviors"
                    xmlns:m="clr-namespace:AiCodingHub.Core.Models;assembly=AiCodingHub.Core">

    <!-- Shared converter instances (app-wide so any widget template can use them). -->
    <conv:ContextColorConverter x:Key="ContextColor" />
    <conv:AlertSeverityColorConverter x:Key="AlertColor" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ===================== Sessions dashboard (main view) ===================== -->

    <!-- Fill colour by context severity level (0 ok · 1 warn · 2 high · 3 critical). -->
    <Style x:Key="Hud.LevelFill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hud.Status.Ok}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="3">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.Critical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hud.GroupLevelFill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hud.Status.Ok}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MaxLevel}" Value="1">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MaxLevel}" Value="2">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MaxLevel}" Value="3">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.Critical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- % text: normal colour while ok, severity colour from the warn band up. -->
    <Style x:Key="Hud.LevelText" TargetType="TextBlock" BasedOn="{StaticResource Hud.NumberText}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="3">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Critical}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hud.GroupLevelText" TargetType="TextBlock" BasedOn="{StaticResource Hud.NumberText}">
        <Setter Property="Foreground" Value="{DynamicResource Hud.Foreground.Subtle}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MaxLevel}" Value="1">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MaxLevel}" Value="2">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MaxLevel}" Value="3">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Critical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One session row: role · name / id · model · context bar · % · state dot -->
    <DataTemplate DataType="{x:Type w:SessionRowViewModel}">
        <Border x:Name="Row" CornerRadius="6" Padding="4,0,6,0" Height="30" Margin="0,1,0,0"
                Background="Transparent" ToolTip="{Binding ToolTipText}"
                ToolTipService.InitialShowDelay="400">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Focus marker -->
                <Border x:Name="FocusBar" Width="3" Height="14" CornerRadius="1.5" Margin="-4,0,0,0"
                        HorizontalAlignment="Left" Background="{DynamicResource Hud.Accent}" Visibility="Collapsed" />

                <!-- Leader star -->
                <Path x:Name="Star" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="{DynamicResource Hud.Leader}"
                      Data="M12,3 L14.7,8.6 L20.8,9.5 L16.4,13.8 L17.4,19.9 L12,17 L6.6,19.9 L7.6,13.8 L3.2,9.5 L9.3,8.6 Z" />

                <!-- Name, short id below -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Hud.Foreground}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortId}" Style="{StaticResource Hud.IdText}" FontSize="9.5"
                               Foreground="{DynamicResource Hud.Foreground.Muted}" Margin="0,-1,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding ModelLabel}" FontSize="10.5"
                           Foreground="{DynamicResource Hud.Foreground.Subtle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Context bar with a tick at the warn threshold (80%) -->
                <Grid Grid.Column="3" Height="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Height="6" CornerRadius="3" Background="{DynamicResource Hud.Track}" />
                    <Border Grid.ColumnSpan="2" Height="6" CornerRadius="3" Style="{StaticResource Hud.LevelFill}"
                            b:Motion.ScaleX="{Binding Fraction}" />
                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="{DynamicResource Hud.Tick}" />
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding PercentText}" Style="{StaticResource Hud.LevelText}"
                           HorizontalAlignment="Right" />

                <!-- State dot: blinks while active, grey when idle, hollow when ended, accent + ring when it needs you -->
                <Grid Grid.Column="5" Width="8" Height="8" HorizontalAlignment="Right">
                    <Ellipse x:Name="Halo" Fill="{DynamicResource Hud.Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Dot" Fill="{DynamicResource Hud.Status.Ok}" Stroke="{DynamicResource Hud.Status.Ok}"
                             StrokeThickness="1.5" />
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLeader}" Value="True">
                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter TargetName="FocusBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hud.Row.Focus}" />
            </DataTrigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hud.Card.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding Activity}" Value="{x:Static m:SessionActivity.Active}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Blink">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.35" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Blink" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="{x:Static m:SessionActivity.Idle}">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hud.Status.Idle}" />
                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Hud.Status.Idle}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="{x:Static m:SessionActivity.Ended}">
                <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Hud.Status.Idle}" />
                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
            </DataTrigger>
            <!-- Needs you: last so it wins over the activity styling -->
            <DataTrigger Binding="{Binding NeedsDecision}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hud.Accent.Soft}" />
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hud.Accent}" />
                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Hud.Accent}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="RowHalo">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="2.4" Duration="0:0:1.6" />
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="2.4" Duration="0:0:1.6" />
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                                             From="0.6" To="0" Duration="0:0:1.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="RowHalo" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One repo group: clickable header + rows (compact: header only, with a mini bar) -->
    <DataTemplate DataType="{x:Type w:SessionGroupViewModel}">
        <StackPanel>
        <!-- Divider between repo blocks: a quiet hairline; solid accent when a session below needs the owner. -->
        <Grid x:Name="Divider" Height="14" Margin="16,0" IsHitTestVisible="False">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource Hud.Divider}" />
            <Rectangle x:Name="DecisionLine" Height="1" VerticalAlignment="Center" Fill="{DynamicResource Hud.Accent.Border}"
                       Visibility="Collapsed" />
        </Grid>
        <Grid>
        <Border x:Name="Card" Background="{DynamicResource Hud.Card}" BorderBrush="{DynamicResource Hud.Card.Border}"
                BorderThickness="1" CornerRadius="9" Padding="6">
            <StackPanel>
                <Border x:Name="Header" Background="Transparent" CornerRadius="6" Padding="4,3,6,4" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                    </Border.InputBindings>
                    <DockPanel>
                        <Path x:Name="Chevron" Width="9" Height="9" Stretch="Uniform" Margin="0,0,8,0"
                              VerticalAlignment="Center" Stroke="{DynamicResource Hud.Foreground.Muted}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Data="M6,9 L12,15 L18,9" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CostText}" Style="{StaticResource Hud.NumberText}"
                                   FontSize="12.5" FontWeight="SemiBold" MinWidth="48" TextAlignment="Right" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MaxPercentText}"
                                   Style="{StaticResource Hud.GroupLevelText}" Margin="8,0,8,0"
                                   ToolTip="Highest context in this group" />
                        <!-- compact only: worst context as a mini bar -->
                        <Grid x:Name="MiniBar" DockPanel.Dock="Right" Width="64" Height="5" Visibility="Collapsed">
                            <Border CornerRadius="2.5" Background="{DynamicResource Hud.Track}" />
                            <Border CornerRadius="2.5" Style="{StaticResource Hud.GroupLevelFill}"
                                    b:Motion.ScaleX="{Binding MaxFraction}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Hud.Foreground}" TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource Hud.Accent.Soft}" CornerRadius="8" Padding="7,1"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LiveText}" FontSize="10.5" Foreground="{DynamicResource Hud.Accent.Strong}" />
                            </Border>
                            <Grid x:Name="GroupDot" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="Collapsed" ToolTip="A session here needs your decision">
                                <Ellipse x:Name="GroupHalo" Fill="{DynamicResource Hud.Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Fill="{DynamicResource Hud.Accent}" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}" Focusable="False" />
            </StackPanel>
        </Border>
        <!-- "Working" orbit: a comet circling the card border while any session here is active,
             driven like a drift car: fast on straights, smooth braking into bends where the head
             glows (Flash) and a tyre mark is left on the bend (Mark). Head = short bright dash; tail =
             longer faint dash lagging behind it. -->
        <Rectangle x:Name="OrbitTail" RadiusX="9" RadiusY="9" StrokeThickness="1.5" IsHitTestVisible="False"
                   Stroke="{DynamicResource Hud.Accent}" Opacity="0.28" StrokeDashCap="Round" Visibility="Collapsed"
                   b:Orbit.Length="120" b:Orbit.Lag="84" />
        <!-- tyre mark: lights up on each bend as the car exits, then fades behind it -->
        <Rectangle x:Name="OrbitMark" RadiusX="9" RadiusY="9" StrokeThickness="2.2" IsHitTestVisible="False"
                   Stroke="{DynamicResource Hud.Accent}" StrokeDashCap="Round" Opacity="0" Visibility="Collapsed"
                   b:Orbit.Length="1" b:Orbit.Mark="True" />
        <Rectangle x:Name="OrbitHead" RadiusX="9" RadiusY="9" StrokeThickness="1.5" IsHitTestVisible="False"
                   Stroke="{DynamicResource Hud.Accent}" StrokeDashCap="Round" Visibility="Collapsed"
                   b:Orbit.Length="36" b:Orbit.Flash="True" />
        </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                <Setter TargetName="OrbitTail" Property="Visibility" Value="Visible" />
                <Setter TargetName="OrbitHead" Property="Visibility" Value="Visible" />
                <Setter TargetName="OrbitMark" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- no divider above the first block -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                <Setter TargetName="Header" Property="Background" Value="{DynamicResource Hud.Card.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chevron" Property="Data" Value="M9,6 L15,12 L9,18" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsDecision}" Value="True">
                <Setter TargetName="GroupDot" Property="Visibility" Value="Visible" />
                <Setter TargetName="OrbitTail" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="OrbitHead" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="OrbitMark" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DecisionLine" Property="Visibility" Value="Visible" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Hud.Accent.Border}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="GroupPulse">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="GroupHalo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="2.4" Duration="0:0:1.6" />
                            <DoubleAnimation Storyboard.TargetName="GroupHalo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="2.4" Duration="0:0:1.6" />
                            <DoubleAnimation Storyboard.TargetName="GroupHalo" Storyboard.TargetProperty="Opacity"
                                             From="0.6" To="0" Duration="0:0:1.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="GroupPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <!-- Compact mode: header only, with the mini bar -->
            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MiniBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chevron" Property="Data" Value="M9,6 L15,12 L9,18" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- "Needs you" strip (one per session waiting on the owner) -->
    <DataTemplate DataType="{x:Type w:DecisionStripViewModel}">
        <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTipText}" Cursor="Hand" Margin="0,0,0,8"
                Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Strip" CornerRadius="8" Padding="10,7" BorderThickness="1"
                            Background="{DynamicResource Hud.Accent.Soft}" BorderBrush="{DynamicResource Hud.Accent.Border}">
                        <DockPanel>
                            <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource Hud.Accent}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6,8 A6,6 0 0 1 18,8 C18,15 21,17 21,17 L3,17 C3,17 6,15 6,8 Z M10.3,21 A1.94,1.94 0 0 0 13.7,21" />
                            <TextBlock DockPanel.Dock="Right" Text="Open" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Hud.Accent.Strong}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Waited}" FontSize="11"
                                       Foreground="{DynamicResource Hud.Foreground.Subtle}" VerticalAlignment="Center"
                                       Margin="8,0,12,0" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Hud.Foreground}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Strip" Property="BorderBrush" Value="{DynamicResource Hud.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- The dashboard widget -->
    <DataTemplate DataType="{x:Type w:SessionsWidgetViewModel}">
        <Grid Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" />
            <StackPanel Margin="0,18,0,22" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <Path Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"
                      Stroke="{DynamicResource Hud.Foreground.Muted}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4,17 L10,12 L4,7 M12,19 L20,19" />
                <TextBlock Text="No active Claude sessions" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource Hud.Foreground}" HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="Start Claude Code in a terminal and it shows up here."
                           Style="{StaticResource Hud.MutedText}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===================== Detail widgets (off by default) ===================== -->

    <!-- Model -->
    <DataTemplate DataType="{x:Type w:ModelWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Model" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Model}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- Session -->
    <DataTemplate DataType="{x:Type w:SessionWidgetViewModel}">
        <StackPanel Margin="0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Project" Style="{StaticResource Hud.LabelText}" />
                <TextBlock Grid.Column="1" Text="{Binding Project}" Style="{StaticResource Hud.ValueText}" />
            </Grid>
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Session" Style="{StaticResource Hud.LabelText}" />
                <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Hud.ValueText}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Context -->
    <DataTemplate DataType="{x:Type w:ContextWidgetViewModel}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Context" Style="{StaticResource Hud.LabelText}" />
            <ProgressBar Grid.Column="1"
                         Style="{StaticResource Hud.ProgressBar}"
                         Value="{Binding Percent}"
                         Foreground="{Binding Percent, Converter={StaticResource ContextColor}}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Percent, StringFormat={}{0:0}%}"
                       Style="{StaticResource Hud.ValueText}" />
        </Grid>
    </DataTemplate>

    <!-- Cost -->
    <DataTemplate DataType="{x:Type w:CostWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cost" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Session}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Today}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- CPU -->
    <DataTemplate DataType="{x:Type w:CpuWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Total}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Claude}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- History (context-usage trend sparkline) -->
    <DataTemplate DataType="{x:Type w:HistoryWidgetViewModel}">
        <StackPanel Margin="0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="History" Style="{StaticResource Hud.LabelText}" />
                <TextBlock Grid.Column="1" Text="{Binding Current}"
                           Style="{StaticResource Hud.ValueText}" HorizontalAlignment="Right" />
            </Grid>
            <Border Height="40" Margin="0,5,0,0" CornerRadius="6"
                    Background="{DynamicResource Hud.Track}">
                <Polyline Points="{Binding Points}" Stretch="Fill" Margin="6"
                          Stroke="{DynamicResource Hud.Accent}" StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- RAM -->
    <DataTemplate DataType="{x:Type w:RamWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RAM" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Total}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Claude}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
