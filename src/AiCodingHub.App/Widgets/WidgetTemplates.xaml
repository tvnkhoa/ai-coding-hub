<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AiCodingHub.App.Converters"
                    xmlns:w="clr-namespace:AiCodingHub.App.Widgets"
                    xmlns:b="clr-namespace:AiCodingHub.App.Behaviors"
                    xmlns:m="clr-namespace:AiCodingHub.Core.Models;assembly=AiCodingHub.Core">

    <!-- Shared converter instances (app-wide so any widget template can use them). -->
    <conv:ContextColorConverter x:Key="ContextColor" />
    <conv:AlertSeverityColorConverter x:Key="AlertColor" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ===================== Sessions dashboard (main view) ===================== -->

    <!-- Fill colour by context severity level (0 ok · 1 warn · 2 high · 3 critical). -->
    <Style x:Key="Hud.LevelFill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hud.Status.Ok}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="3">
                <Setter Property="Background" Value="{DynamicResource Hud.Status.Critical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hud.LevelText" TargetType="TextBlock" BasedOn="{StaticResource Hud.NumberText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="3">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Critical}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hud.GroupLevelText" TargetType="TextBlock" BasedOn="{StaticResource Hud.NumberText}">
        <Setter Property="Foreground" Value="{DynamicResource Hud.Foreground.Subtle}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MaxLevel}" Value="1">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MaxLevel}" Value="2">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MaxLevel}" Value="3">
                <Setter Property="Foreground" Value="{DynamicResource Hud.Status.Critical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One session row: role · id · model · context bar · % · cost · activity dot -->
    <DataTemplate DataType="{x:Type w:SessionRowViewModel}">
        <Border x:Name="Row" CornerRadius="5" Padding="4,0,6,0" Height="26" Margin="0,1"
                Background="Transparent" ToolTip="{Binding ToolTipText}"
                ToolTipService.InitialShowDelay="350">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" MinWidth="40" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Focus marker -->
                <Border x:Name="FocusBar" Width="3" Height="14" CornerRadius="1.5" Margin="-4,0,0,0"
                        HorizontalAlignment="Left" Background="{DynamicResource Hud.Accent}" Visibility="Collapsed" />

                <!-- Role: star for the leader -->
                <TextBlock x:Name="RoleGlyph" Style="{StaticResource Hud.Icon}" FontSize="11"
                           Text="&#xE735;" Foreground="{DynamicResource Hud.Leader}" Visibility="Collapsed" />

                <TextBlock Grid.Column="1" Text="{Binding ShortId}" Style="{StaticResource Hud.IdText}" />
                <TextBlock Grid.Column="2" Text="{Binding ModelLabel}" Style="{StaticResource Hud.ValueText}"
                           FontSize="11.5" Margin="2,0,8,0" />

                <!-- Context bar (eases between values) -->
                <Grid Grid.Column="3" Height="5" VerticalAlignment="Center" ClipToBounds="True">
                    <Border CornerRadius="2.5" Background="{DynamicResource Hud.Track}" />
                    <Border CornerRadius="2.5" Style="{StaticResource Hud.LevelFill}"
                            b:Motion.ScaleX="{Binding Fraction}" />
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding PercentText}" Style="{StaticResource Hud.LevelText}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding CostText}" Style="{StaticResource Hud.NumberText}"
                           Foreground="{DynamicResource Hud.Foreground.Subtle}" FontSize="11.5"
                           HorizontalAlignment="Right" />

                <!-- Activity dot: pulses while active, grey when idle, hollow when ended -->
                <Ellipse x:Name="Dot" Grid.Column="6" Width="7" Height="7" HorizontalAlignment="Right"
                         Fill="{DynamicResource Hud.Status.Ok}" StrokeThickness="1.2" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLeader}" Value="True">
                <Setter TargetName="RoleGlyph" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter TargetName="FocusBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hud.Accent.Soft}" />
            </DataTrigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hud.Card.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding Activity}" Value="{x:Static m:SessionActivity.Active}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Pulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.35" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Pulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="{x:Static m:SessionActivity.Idle}">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hud.Status.Idle}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="{x:Static m:SessionActivity.Ended}">
                <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Hud.Status.Idle}" />
                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One repo group: clickable header + rows -->
    <DataTemplate DataType="{x:Type w:SessionGroupViewModel}">
        <Border Background="{DynamicResource Hud.Card}" CornerRadius="8" Padding="6,4,6,5" Margin="0,0,0,6">
            <StackPanel>
                <Border x:Name="Header" Background="Transparent" CornerRadius="5" Padding="2,3,6,3" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                    </Border.InputBindings>
                    <DockPanel>
                        <TextBlock x:Name="Chevron" Style="{StaticResource Hud.Icon}" FontSize="9" Width="16"
                                   Text="&#xE70D;" Foreground="{DynamicResource Hud.Foreground.Muted}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CostText}" Style="{StaticResource Hud.NumberText}"
                                   FontWeight="SemiBold" Margin="10,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MaxPercentText}"
                                   Style="{StaticResource Hud.GroupLevelText}" Margin="8,0,0,0"
                                   ToolTip="Highest context in this group" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource Hud.Chip}">
                            <TextBlock Text="{Binding LiveText}" FontSize="10.5"
                                       Foreground="{DynamicResource Hud.Accent}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Hud.ValueText}"
                                   FontWeight="SemiBold" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}" Margin="0,2,0,0" Focusable="False" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                <Setter TargetName="Header" Property="Background" Value="{DynamicResource Hud.Card.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
            </DataTrigger>
            <!-- Compact mode shows group headers only -->
            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The dashboard widget -->
    <DataTemplate DataType="{x:Type w:SessionsWidgetViewModel}">
        <Grid>
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" />
            <StackPanel Margin="0,18,0,18" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Hud.Icon}" FontSize="22" Text="&#xE9D9;"
                           Foreground="{DynamicResource Hud.Foreground.Muted}" />
                <TextBlock Text="No active Claude sessions" Style="{StaticResource Hud.ValueText}"
                           HorizontalAlignment="Center" Margin="0,8,0,2" />
                <TextBlock Text="Start Claude Code in a terminal and it shows up here."
                           Style="{StaticResource Hud.MutedText}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===================== Detail widgets (off by default) ===================== -->

    <!-- Model -->
    <DataTemplate DataType="{x:Type w:ModelWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Model" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Model}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- Session -->
    <DataTemplate DataType="{x:Type w:SessionWidgetViewModel}">
        <StackPanel Margin="0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Project" Style="{StaticResource Hud.LabelText}" />
                <TextBlock Grid.Column="1" Text="{Binding Project}" Style="{StaticResource Hud.ValueText}" />
            </Grid>
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Session" Style="{StaticResource Hud.LabelText}" />
                <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Hud.ValueText}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Context -->
    <DataTemplate DataType="{x:Type w:ContextWidgetViewModel}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Context" Style="{StaticResource Hud.LabelText}" />
            <ProgressBar Grid.Column="1"
                         Style="{StaticResource Hud.ProgressBar}"
                         Value="{Binding Percent}"
                         Foreground="{Binding Percent, Converter={StaticResource ContextColor}}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Percent, StringFormat={}{0:0}%}"
                       Style="{StaticResource Hud.ValueText}" />
        </Grid>
    </DataTemplate>

    <!-- Cost -->
    <DataTemplate DataType="{x:Type w:CostWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cost" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Session}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Today}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- Usage (subscription 5h / weekly limits) -->
    <DataTemplate DataType="{x:Type w:UsageWidgetViewModel}">
        <StackPanel Margin="0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Usage" Style="{StaticResource Hud.LabelText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Hud.MutedText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                           Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}" />
                <Button Grid.Column="2" Content="&#xE72C;" Command="{Binding RefreshCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Hud.IconButton}">
                            <Setter Property="ToolTip" Value="Refresh usage now" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="ToolTip" Value="Refreshing…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 5-hour window -->
            <Grid Margin="0,4,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="5h" Style="{StaticResource Hud.MutedText}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Style="{StaticResource Hud.ProgressBar}"
                             Value="{Binding FiveHourPercent}"
                             Foreground="{Binding FiveHourPercent, Converter={StaticResource ContextColor}}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding FiveHourText}" Style="{StaticResource Hud.ValueText}" />
            </Grid>
            <TextBlock Text="{Binding FiveHourReset}" Style="{StaticResource Hud.MutedText}"
                       HorizontalAlignment="Right" Margin="0,1,0,0"
                       Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />

            <!-- Weekly window -->
            <Grid Margin="0,4,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="7d" Style="{StaticResource Hud.MutedText}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Style="{StaticResource Hud.ProgressBar}"
                             Value="{Binding WeeklyPercent}"
                             Foreground="{Binding WeeklyPercent, Converter={StaticResource ContextColor}}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding WeeklyText}" Style="{StaticResource Hud.ValueText}" />
            </Grid>
            <TextBlock Text="{Binding WeeklyReset}" Style="{StaticResource Hud.MutedText}"
                       HorizontalAlignment="Right" Margin="0,1,0,0"
                       Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DataTemplate>

    <!-- CPU -->
    <DataTemplate DataType="{x:Type w:CpuWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Total}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Claude}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- History (context-usage trend sparkline) -->
    <DataTemplate DataType="{x:Type w:HistoryWidgetViewModel}">
        <StackPanel Margin="0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="History" Style="{StaticResource Hud.LabelText}" />
                <TextBlock Grid.Column="1" Text="{Binding Current}"
                           Style="{StaticResource Hud.ValueText}" HorizontalAlignment="Right" />
            </Grid>
            <Border Height="40" Margin="0,5,0,0" CornerRadius="6"
                    Background="{DynamicResource Hud.Track}">
                <Polyline Points="{Binding Points}" Stretch="Fill" Margin="6"
                          Stroke="{DynamicResource Hud.Accent}" StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- RAM -->
    <DataTemplate DataType="{x:Type w:RamWidgetViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RAM" Style="{StaticResource Hud.LabelText}" />
            <TextBlock Grid.Column="1" Text="{Binding Total}" Style="{StaticResource Hud.ValueText}" />
            <TextBlock Grid.Column="2" Text="{Binding Claude}" Style="{StaticResource Hud.MutedText}"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
