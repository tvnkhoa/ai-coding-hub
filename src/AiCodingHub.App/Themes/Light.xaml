<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme tokens (see Dark.xaml for the meaning of each key). -->
    <SolidColorBrush x:Key="Hud.Background"            Color="#F5FBFBFD" />
    <SolidColorBrush x:Key="Hud.Background.Backdrop"   Color="#F5FBFBFD" />
    <SolidColorBrush x:Key="Hud.Header.Background"     Color="#00000000" />
    <SolidColorBrush x:Key="Hud.Header.Hover"          Color="#12000000" />
    <SolidColorBrush x:Key="Hud.Footer.Background"     Color="#05000000" />
    <SolidColorBrush x:Key="Hud.Card"                  Color="#06000000" />
    <SolidColorBrush x:Key="Hud.Card.Border"           Color="#0F000000" />
    <SolidColorBrush x:Key="Hud.Card.Hover"            Color="#0D000000" />
    <SolidColorBrush x:Key="Hud.Row.Focus"             Color="#0B000000" />
    <SolidColorBrush x:Key="Hud.Border"                Color="#17000000" />
    <SolidColorBrush x:Key="Hud.Divider"               Color="#12000000" />
    <SolidColorBrush x:Key="Hud.Foreground"            Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="Hud.Foreground.Subtle"     Color="#FF55565E" />
    <SolidColorBrush x:Key="Hud.Foreground.Muted"      Color="#FF6B6C74" />
    <SolidColorBrush x:Key="Hud.Track"                 Color="#14000000" />
    <SolidColorBrush x:Key="Hud.Tick"                  Color="#40000000" />
    <SolidColorBrush x:Key="Hud.Leader"                Color="#FFB7791F" />

    <SolidColorBrush x:Key="Hud.Accent"                Color="#FF005FB8" />
    <SolidColorBrush x:Key="Hud.Accent.Strong"         Color="#FF005FB8" />
    <SolidColorBrush x:Key="Hud.Accent.Soft"           Color="#17005FB8" />
    <SolidColorBrush x:Key="Hud.Accent.Border"         Color="#59005FB8" />
    <SolidColorBrush x:Key="Hud.OnAccent"              Color="#FFFFFFFF" />
    <Color x:Key="Hud.Accent.Color">#FF005FB8</Color>

    <SolidColorBrush x:Key="Hud.Live"                  Color="#FF1A7F4B" />
    <SolidColorBrush x:Key="Hud.Live.Soft"             Color="#1C1A7F4B" />

    <SolidColorBrush x:Key="Hud.Status.Ok"             Color="#FF1A7F4B" />
    <SolidColorBrush x:Key="Hud.Status.Warn"           Color="#FF9A6700" />
    <SolidColorBrush x:Key="Hud.Status.High"           Color="#FFBC4C00" />
    <SolidColorBrush x:Key="Hud.Status.Critical"       Color="#FFCF222E" />
    <SolidColorBrush x:Key="Hud.Status.Idle"           Color="#FF8C8C94" />

</ResourceDictionary>
