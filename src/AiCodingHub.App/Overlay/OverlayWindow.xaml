<Window x:Class="AiCodingHub.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:AiCodingHub.App.Behaviors"
        Title="Mini Monitor"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="376"
        MinHeight="90"
        MaxHeight="860"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="{Binding IsPinned}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FontFamily="{Binding Font, FallbackValue='Segoe UI'}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Non-layered window with the glass frame over the whole client area: DWM paints the
         Windows 11 acrylic backdrop behind the transparent background (see WindowInterop). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Header icon button with a vector glyph -->
        <Style x:Key="Hud.GlyphButton" TargetType="Button" BasedOn="{StaticResource Hud.IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style x:Key="Hud.Glyph" TargetType="Path">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="Hud.FooterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Hud.Foreground.Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background tint (its opacity is the HUD opacity; text stays fully opaque). -->
        <Border CornerRadius="10" Opacity="{Binding BackgroundOpacity}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Hud.Background}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Hud.Border}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseBackdrop}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Hud.Background.Backdrop}" />
                            <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar (drag handle + controls) ===== -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource Hud.Header.Background}"
                    Padding="14,10,8,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Bell: only while a session needs the owner -->
                        <Button Style="{StaticResource Hud.GlyphButton}" Command="{Binding Host.OpenFirstDecisionCommand}"
                                Background="{DynamicResource Hud.Accent.Soft}" Foreground="{DynamicResource Hud.Accent}"
                                Margin="0,0,2,0" ToolTip="A session needs your decision — open it"
                                Visibility="{Binding Host.HasDecision, Converter={StaticResource BoolToVis}}">
                            <Grid Width="28" Height="26">
                                <Path Style="{StaticResource Hud.Glyph}" Width="14" Height="14"
                                      Data="M6,8 A6,6 0 0 1 18,8 C18,15 21,17 21,17 L3,17 C3,17 6,15 6,8 Z M10.3,21 A1.94,1.94 0 0 0 13.7,21" />
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
                                    <Border x:Name="BadgeHalo" CornerRadius="7" Background="{DynamicResource Hud.Accent}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.9" Duration="0:0:1.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.9" Duration="0:0:1.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <Border MinWidth="13" Height="13" Padding="3,0" CornerRadius="7" Background="{DynamicResource Hud.Accent}">
                                        <TextBlock Text="{Binding Host.DecisionCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Hud.OnAccent}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Theme: sun while dark (→ light), moon while light (→ dark).
                             One Path whose Data switches: a UIElement in a style Setter is shared
                             and can drop out of the tree when the trigger flips. -->
                        <Button Command="{Binding ToggleThemeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Hud.GlyphButton}">
                                    <Setter Property="ToolTip" Value="Switch to light theme" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLight}" Value="True">
                                            <Setter Property="ToolTip" Value="Switch to dark theme" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Hud.Glyph}">
                                        <Setter Property="Data" Value="M12,8 A4,4 0 1 1 11.99,8 Z M12,2 L12,4 M12,20 L12,22 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M2,12 L4,12 M20,12 L22,12 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLight}" Value="True">
                                                <Setter Property="Data" Value="M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- Compact / expand -->
                        <Button Command="{Binding ToggleCompactCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Hud.GlyphButton}">
                                    <Setter Property="ToolTip" Value="Compact: group headers only" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                            <Setter Property="ToolTip" Value="Expand: show every session" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path>
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Hud.Glyph}">
                                        <Setter Property="Data" Value="M4,14 L10,14 L10,20 M20,10 L14,10 L14,4 M14,10 L21,3 M3,21 L10,14" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                <Setter Property="Data" Value="M15,3 L21,3 L21,9 M9,21 L3,21 L3,15 M21,3 L14,10 M3,21 L10,14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- Pin on top -->
                        <Button Command="{Binding TogglePinCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Hud.GlyphButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource Hud.Accent}" />
                                    <Setter Property="ToolTip" Value="Pinned on top — click to unpin" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Hud.Foreground.Subtle}" />
                                            <Setter Property="ToolTip" Value="Not on top — click to pin" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Style="{StaticResource Hud.Glyph}" Data="M12,17 L12,22 M9,3 L15,3 L14,9 L18,13 L6,13 L10,9 Z" />
                        </Button>

                        <!-- Exit -->
                        <Button Style="{StaticResource Hud.CloseButton}" Width="28" Height="26" ToolTip="Exit"
                                Command="{Binding ExitCommand}">
                            <Path Style="{StaticResource Hud.Glyph}" Width="11" Height="11" Data="M5,5 L19,19 M19,5 L5,19" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App mark -->
                        <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Hud.Accent}">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Hud.OnAccent}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M3,12 L7,12 L10,4 L14,20 L17,12 L21,12" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Hud.TitleText}" Margin="8,0,8,0" />
                        <!-- Live sessions: terminal glyph + count -->
                        <Border Height="18" Padding="6,0" CornerRadius="5" Background="{DynamicResource Hud.Live.Soft}"
                                VerticalAlignment="Center" ToolTip="{Binding Host.LiveToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource Hud.Live}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M4,17 L10,12 L4,7 M12,19 L20,19" />
                                <TextBlock Text="{Binding Host.LiveCount}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Hud.Live}" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Body: "needs you" strips, then the widgets ===== -->
            <!-- The margin lives inside the scrolled content: ScrollViewer padding is outside its
                 clip, so the race car riding on a card's border would be cut off there. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,2" Focusable="False">
                <StackPanel Margin="8,6,8,2">
                    <ItemsControl ItemsSource="{Binding Host.Decisions}" Focusable="False" />
                    <ItemsControl ItemsSource="{Binding Host.VisibleWidgets}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Transient alert banner (context / cost / idle; decisions use the strip). -->
            <Border Grid.Row="1" VerticalAlignment="Top" Margin="10,2"
                    Panel.ZIndex="10"
                    CornerRadius="8" Padding="10,7"
                    Background="{Binding Banner.Severity, Converter={StaticResource AlertColor}}"
                    Visibility="{Binding Banner.IsVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Banner.IsVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                            Style="{StaticResource Hud.IconButton}" Width="22" Height="22"
                            Foreground="White" ToolTip="Dismiss" Command="{Binding Banner.DismissCommand}">
                        <Path Width="9" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,5 L19,19 M19,5 L5,19" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Banner.Title}" Foreground="White"
                                   FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Banner.Message}" Foreground="White"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.9" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2" Background="{DynamicResource Hud.Footer.Background}"
                    BorderBrush="{DynamicResource Hud.Divider}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid>
                    <!-- Full: four stat blocks -->
                    <Grid x:Name="FullFooter" Margin="12,9,12,11">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TODAY" Style="{StaticResource Hud.FooterLabel}" />
                            <TextBlock Text="{Binding Host.TodayCost}" Style="{StaticResource Hud.NumberText}"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="WEEK" Style="{StaticResource Hud.FooterLabel}" />
                            <TextBlock Text="{Binding Host.WeekCost}" Style="{StaticResource Hud.NumberText}"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0" ToolTip="{Binding Host.UsageToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LIMITS" Style="{StaticResource Hud.FooterLabel}" VerticalAlignment="Center" />
                                <Button x:Name="RefreshFull" Style="{StaticResource Hud.IconButton}" Width="16" Height="16"
                                        Margin="4,0,0,0" ToolTip="Refresh usage limits now"
                                        Command="{Binding Host.RefreshUsageCommand}">
                                    <Path x:Name="RefreshGlyph" Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5" Data="M21,12 A9,9 0 1 1 18.4,5.6 M21,4 L21,9 L16,9">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Host.IsRefreshingUsage}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="Spin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360" Duration="0:0:0.9" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Spin" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </StackPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="5h" Width="18" FontSize="10.5"
                                           Foreground="{DynamicResource Hud.Foreground.Muted}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Host.UsageText}" Style="{StaticResource Hud.NumberText}"
                                           FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0" MinWidth="28" TextAlignment="Right" />
                                <Grid Height="4" VerticalAlignment="Center">
                                    <Border CornerRadius="2" Background="{DynamicResource Hud.Track}" />
                                    <Border CornerRadius="2" b:Motion.ScaleX="{Binding Host.UsageFraction}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Hud.Status.Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Host.UsageLevel}" Value="1">
                                                        <Setter Property="Background" Value="{DynamicResource Hud.Status.Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Host.UsageLevel}" Value="2">
                                                        <Setter Property="Background" Value="{DynamicResource Hud.Status.High}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Host.UsageLevel}" Value="3">
                                                        <Setter Property="Background" Value="{DynamicResource Hud.Status.Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="7d" Width="18" FontSize="10.5"
                                           Foreground="{DynamicResource Hud.Foreground.Muted}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Host.WeeklyText}" Style="{StaticResource Hud.NumberText}"
                                           FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0" MinWidth="28" TextAlignment="Right" />
                                <Grid Height="4" VerticalAlignment="Center">
                                    <Border CornerRadius="2" Background="{DynamicResource Hud.Track}" />
                                    <Border CornerRadius="2" b:Motion.ScaleX="{Binding Host.WeeklyFraction}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Hud.Status.Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Host.WeeklyLevel}" Value="1">
                                                        <Setter Property="Background" Value="{DynamicResource Hud.Status.Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Host.WeeklyLevel}" Value="2">
                                                        <Setter Property="Background" Value="{DynamicResource Hud.Status.High}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Host.WeeklyLevel}" Value="3">
                                                        <Setter Property="Background" Value="{DynamicResource Hud.Status.Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right"
                                    ToolTip="CPU and memory of all Claude Code processes">
                            <TextBlock Text="CLAUDE" Style="{StaticResource Hud.FooterLabel}" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Host.CpuText}" Style="{StaticResource Hud.NumberText}" FontSize="11.5"
                                           Foreground="{DynamicResource Hud.Foreground.Subtle}" FontWeight="Normal" />
                                <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource Hud.Foreground.Subtle}" />
                                <TextBlock Text="{Binding Host.RamText}" Style="{StaticResource Hud.NumberText}" FontSize="11.5"
                                           Foreground="{DynamicResource Hud.Foreground.Subtle}" FontWeight="Normal" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Compact: one line -->
                    <DockPanel Margin="14,8,12,10" Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding Host.CpuText}" Style="{StaticResource Hud.NumberText}" FontSize="11.5"
                                       Foreground="{DynamicResource Hud.Foreground.Subtle}" FontWeight="Normal" />
                            <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource Hud.Foreground.Subtle}" />
                            <TextBlock Text="{Binding Host.RamText}" Style="{StaticResource Hud.NumberText}" FontSize="11.5"
                                       Foreground="{DynamicResource Hud.Foreground.Subtle}" FontWeight="Normal" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Today " FontSize="11.5" Foreground="{DynamicResource Hud.Foreground.Muted}" />
                            <TextBlock Text="{Binding Host.TodayCost}" Style="{StaticResource Hud.NumberText}" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="Week " FontSize="11.5" Foreground="{DynamicResource Hud.Foreground.Muted}" Margin="14,0,0,0" />
                            <TextBlock Text="{Binding Host.WeekCost}" Style="{StaticResource Hud.NumberText}" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="5h " FontSize="11.5" Foreground="{DynamicResource Hud.Foreground.Muted}" Margin="14,0,0,0" />
                            <TextBlock Text="{Binding Host.UsageText}" Style="{StaticResource Hud.NumberText}" FontSize="11.5"
                                       FontWeight="SemiBold" ToolTip="{Binding Host.UsageToolTip}" />
                            <TextBlock Text="7d " FontSize="11.5" Foreground="{DynamicResource Hud.Foreground.Muted}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding Host.WeeklyText}" Style="{StaticResource Hud.NumberText}" FontSize="11.5"
                                       FontWeight="SemiBold" ToolTip="{Binding Host.UsageToolTip}" />
                            <Button Style="{StaticResource Hud.IconButton}" Width="16" Height="16" Margin="4,0,0,0"
                                    ToolTip="Refresh usage limits now" Command="{Binding Host.RefreshUsageCommand}">
                                <Path Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M21,12 A9,9 0 1 1 18.4,5.6 M21,4 L21,9 L16,9" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
